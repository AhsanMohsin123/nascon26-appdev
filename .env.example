# Copy this file to .env and fill in the values
# NEVER commit your real .env file

# Required: your team's per-day cryptographic salt (printed on your slip)
DAY1_SALT=your-day1-salt-here
DAY2_SALT=your-day2-salt-here

# JWT signing secret (change for production)
JWT_SECRET=nascon26-jwt-secret-change-me

# Database (already configured in docker-compose.yml)
POSTGRES_USER=nascon
POSTGRES_PASSWORD=nascon_pass
POSTGRES_DB=nascon_db

# Redis
REDIS_URL=redis://redis:6379

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
